<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />

    <application
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventsInCalendar"
        tools:targetApi="31">
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="RedundantLabel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false" />
<!--        <activity-->
<!--            android:name=".ReviewOYear"-->
<!--            android:exported="false" />-->
        <activity
            android:name=".ReviewOWeek"
            android:exported="false" />
        <activity
            android:name=".ReviewOnMonth"
            android:exported="false" />
        <activity
            android:name=".ReviewOYear"
            android:exported="false" />

        <activity android:name=".ReviewActivity"
            android:theme="@style/AppTheme.Dialog"
            android:exported="false">
            <!--android:exported="true"
            tools:ignore="IntentFilterExportedReceiver">
            -<intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>-->
        </activity>
        <activity android:name=".ReviewTodayActivity"
            android:theme="@style/AppTheme.Dialog"
            android:exported="false">
        </activity>
        <activity android:name=".ListenActivity"
            android:theme="@style/AppTheme.Dialog"
            android:exported="false"
            android:width="50dip"
            android:height="50dip">
        </activity>


        <receiver
            android:name="MyWidget2"
            android:exported="true"
            android:permission="android.permission.BROADCAST_APPWIDGET"

            android:icon="@mipmap/ic_launcher_foreground"
            android:label="@string/widget_name">

            <intent-filter>

                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                    <action android:name="com.example.calendarhours.ACTION_WIDGET_CLICK" />
                    <action android:name="com.example.calendarhours.ACTION_OPEN_CALENDAR" />
                    <action android:name="com.example.calendarhours.ACTION_OPEN_SETTINGS" />
                    <action android:name="com.example.calendarhours.ACTION_OPEN_DAY" />

            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_metadata">
            </meta-data>


        </receiver>


    </application>


</manifest>